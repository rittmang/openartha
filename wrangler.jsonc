{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openartha",
  "account_id": "9fc12763bfcbe072adc2ce40e27dc889",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "openartha.rittmang.xyz",
      "custom_domain": true
    },
    {
      "pattern": "gita.rittmang.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentic-gita",
      "database_id": "24054012-b616-4d15-af0b-51e3ff061df7",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
